# Copy to .env.local per app. NEVER commit real values — repo is public.

# Supabase (URL + anon key are public-safe by design; service role is NOT)
NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=server-only-never-public

# Payments (Stripe dormant until CR issued — leave empty)
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=

# WhatsApp via Twilio
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_WHATSAPP_FROM=

# Gemini (Help Center assistant)
GEMINI_API_KEY=
